# Copy this file to .env and fill in real values.
# Create the OAuth App at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:             http://localhost:4000
#   Authorization callback URL: http://localhost:4000/auth/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any random string — signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional overrides (defaults shown)
# PORT=4000
# TRAEFIK_HTTP_PORT=8000
# TRAEFIK_API_PORT=8081
